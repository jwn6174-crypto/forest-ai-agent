  "matching_function_pseudocode": {
    "input": "stand_state {species, age, area_ha, ownership, current_use, history}",
    "rule_based_first": [
      "AR if (age == 0 and history == 'no_forest_1990') → eligible",
      "FM-Rotation if (age >= legal_min - 10) → eligible (extension)",
      "SC if (age >= legal_min and target_species_changed) → eligible",
      "FDP if (fire_history_within_5yr) → eligible"
    ],
    "rag_fallback": [
      "WP if (owner_intent in input) → 정우 RAG 검색 'wood_products' 청크",
      "FB if (biomass_intent) → 정우 RAG 검색 'forest_biomass'",
      "VR/LUA → 정우 RAG 청크 검색"
    ]
  }
