!module_bd/data/interim/kofpi_history.csv
!module_bd/data/interim/kofpi_transport.parquet
!module_bd/data/interim/kofpi_transport.csv
!module_bd/data/interim/kofpi_skidding.parquet
!module_bd/data/interim/kofpi_skidding.csv

# 별표 3 룰베이스 (Day 2 후반)
!module_bd/data/processed/
!module_bd/data/processed/*.json

# 노임 데이터 (대한건설협회 통계, Day 2 후반)
!module_bd/data/raw/wage/
