# ===== 절대 GitHub에 올리면 안 되는 것들 =====

# API 키 (가장 중요!)
.env
.env.*
!.env.example
*.key
api_keys.txt
secrets/

# Python 캐시
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 가상환경
venv/
env/
.venv/
ENV/

# Jupyter Notebook 체크포인트
.ipynb_checkpoints/

# VS Code 개인 설정
.vscode/

# macOS / Windows 시스템 파일
.DS_Store
Thumbs.db
desktop.ini

# 데이터 파일 (크기 큼, GitHub 비효율)
*.csv
*.tif
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.pkl
*.h5
*.parquet
*.pdf
*.xml

# 단, 작은 예시 데이터는 허용
!data/sample/*.csv
!shared/schemas/*.json

# ===== 모듈 B/D 학술 자산 명시적 허용 =====
# 통합 데이터만 포함 (중간 산출물·수종별 개별 CSV 는 제외)

# yield 통합 데이터 (Day 1-2)
!module_bd/data/interim/yield_table_full.parquet
!module_bd/data/interim/yield_table_stand.parquet

